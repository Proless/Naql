<Project>

	<!-- Central Package Management: every package version is set here, project files only name the package -->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup Label="netstandard">
		<PackageVersion Include="PolySharp" Version="1.15.0" />
		<PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup Label="netstandard2.0">
		<PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
		<PackageVersion Include="System.Memory" Version="4.6.3" />
		<PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
	</ItemGroup>

	<!-- The plugin catalog installs plugins from NuGet sources -->
	<ItemGroup Label="App">
		<PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
		<!-- NuGet.Packaging brings 8.0.1, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup Label="Build">
		<PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup Label="Testing">
		<PackageVersion Include="CsCheck" Version="4.9.1" />
		<PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
		<PackageVersion Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>

</Project>
