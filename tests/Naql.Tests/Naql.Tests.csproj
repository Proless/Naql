<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- xunit.v3 4.x runs on Microsoft.Testing.Platform, so Microsoft.NET.Test.Sdk and xunit.runner.visualstudio are not needed -->
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<!--
		The tests use the libraries' net8.0 build, which any current runtime picks. To test the netstandard2.1 build
		instead, run with -p:NaqlTarget=netstandard2.1: the references then ask for that build explicitly.
	-->
	<ItemGroup Condition="'$(NaqlTarget)' == ''">
		<ProjectReference Include="..\..\src\Naql\Naql.csproj" />
		<ProjectReference Include="..\..\src\Naql.Http\Naql.Http.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(NaqlTarget)' != ''">
		<ProjectReference Include="..\..\src\Naql\Naql.csproj" SetTargetFramework="TargetFramework=$(NaqlTarget)" />
		<ProjectReference Include="..\..\src\Naql.Http\Naql.Http.csproj" SetTargetFramework="TargetFramework=$(NaqlTarget)" />
	</ItemGroup>

</Project>
