<Project Sdk="Microsoft.NET.Sdk">

	<!--
		A plugin for the plugin host's tests. The tests never reference it: they copy its assembly into a plugins folder,
		so it can only come in through a load context. The contracts aren't copied along, so they must come from Naqel.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Naqel.Plugins\Naqel.Plugins.csproj" Private="false" />
	</ItemGroup>

</Project>
