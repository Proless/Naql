<Project Sdk="Microsoft.NET.Sdk">

	<!-- The app's manager: jobs, the queue, routing and hooks. It isn't a package; the app's hosts use it -->
	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<TrackPublicApi>false</TrackPublicApi>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Naqel.Manager.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Naqel.Plugins\Naqel.Plugins.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NuGet.Protocol" />
		<!-- Replaces the vulnerable version NuGet.Packaging would bring -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" />
	</ItemGroup>

</Project>
